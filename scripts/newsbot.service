# User= and the paths below are examples. Install from the checkout with your
# own filled in (this leaves the file in the repo untouched):
#   sed "s|/home/john/Documents/news_bot|$PWD|g; s|^User=john|User=$USER|" \
#     scripts/newsbot.service | sudo tee /etc/systemd/system/newsbot.service >/dev/null
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now newsbot

[Unit]
Description=Orbital news and launch tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=john
WorkingDirectory=/home/john/Documents/news_bot
ExecStart=/home/john/Documents/news_bot/.venv/bin/python -m newsbot --config /home/john/Documents/news_bot/config.yaml
Restart=always
RestartSec=10
# Don't restart in a tight loop if something is badly broken
StartLimitBurst=5
StartLimitIntervalSec=120
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
