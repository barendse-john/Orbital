# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token-here

# console.anthropic.com -> API keys. Only needed if ai.backend = anthropic
ANTHROPIC_API_KEY=sk-ant-...

# gnews.io free tier (100 requests/day). Optional: leave blank to use
# Google News RSS only.
GNEWS_API_KEY=

# Google Drive folder whose .md reports appear in the Orbital app (the long
# id at the end of the folder's URL). Optional: blank = off.
# The service account key goes in data/google-service-account.json.
GDRIVE_REPORTS_FOLDER_ID=
